# Copy to .env. Secrets (SMTP password, bot tokens, webhook URLs) go here, never in config.yaml.
# DBW_TELEGRAM_TOKEN=   the Telegram bot token from @BotFather (docs/telegram.md). Edit this file yourself; never paste the token into a chat.
# Phase 1 needs none. Optional: DBW_DB=/path/to/dbw.sqlite (default data/dbw.sqlite)
